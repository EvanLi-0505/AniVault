<UserControl x:Class="AniVault.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="{Binding Icon, ElementName=Root}" FontSize="30" HorizontalAlignment="Center"
                       Visibility="{Binding Icon, ElementName=Root, Converter={StaticResource NotEmptyToVisible}}" />
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Text.Subheading}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Message, ElementName=Root}" Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Button Content="{Binding ActionText, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}"
                    Style="{StaticResource Button.Primary}" Margin="0,16,0,0" HorizontalAlignment="Center"
                    Visibility="{Binding ActionText, ElementName=Root, Converter={StaticResource NotEmptyToVisible}}" />
        </StackPanel>
    </Border>
</UserControl>
