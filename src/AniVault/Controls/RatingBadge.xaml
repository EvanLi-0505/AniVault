<UserControl x:Class="AniVault.Controls.RatingBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource Brush.Scrim}"
            Visibility="{Binding Rating, ElementName=Root, Converter={StaticResource PositiveToVisible}}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="★ " Foreground="{DynamicResource Brush.Star}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Rating, ElementName=Root, StringFormat={}{0:0.0}}"
                       Foreground="{DynamicResource Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</UserControl>
