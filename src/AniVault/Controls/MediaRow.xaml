<UserControl x:Class="AniVault.Controls.MediaRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AniVault.Controls"
             x:Name="Root">
    <StackPanel Margin="0,0,0,8">
        <TextBlock Text="{Binding Header, ElementName=Root}" Style="{StaticResource Text.Subheading}" Margin="0,0,0,10" />
        <!-- PreviewMouseWheel is forwarded to the page's own vertical ScrollViewer (see code-behind):
             a nested ScrollViewer otherwise swallows the wheel while the mouse happens to be over
             this row, making page scrolling feel like it randomly stops working. Horizontal
             scrolling here still works via the scrollbar / click-drag. -->
        <ScrollViewer x:Name="RowScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="OnRowPreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MediaCard Margin="0,0,14,4"
                                            OpenCommand="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType=controls:MediaRow}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
