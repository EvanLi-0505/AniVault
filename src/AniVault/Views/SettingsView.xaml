<UserControl x:Class="AniVault.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="{DynamicResource Brush.Background}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Text.Heading}" />

            <!-- Data folder -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Data folder" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="Your library database, artwork, logs and backups live here." Style="{StaticResource Text.Muted}" Margin="0,4,0,10" />
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DatabaseFilePath, StringFormat='Database: {0}'}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BootstrapFilePath, StringFormat='Config: {0}'}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Open data folder" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="Open logs folder" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding OpenLogsFolderCommand}" />
                        <Button Content="Change data folder…" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding ChangeDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup & data -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0" DataContext="{Binding DataManagement}">
                <StackPanel>
                    <TextBlock Text="Backup &amp; data" Style="{StaticResource Text.Subheading}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,4,0,12"
                               Text="Back up your whole library (database + artwork) to a ZIP you can copy to another drive or computer. On a new machine, install AniVault, then use Restore to load the backup. Everything is offline." />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back up now…" Style="{StaticResource Button.Primary}" Command="{Binding CreateBackupCommand}" />
                        <Button Content="Restore from backup…" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding RestoreBackupCommand}" />
                        <Button Content="Open backup folder" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding OpenBackupFolderCommand}" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,16" />

                    <TextBlock Text="Export a Markdown document listing everything you have watched — full details, grouped by type and watch status (completed vs. still watching)."
                               TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
                    <Button Content="Export library to Markdown…" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Ghost}" Command="{Binding ExportMarkdownCommand}" />

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisible}}" />
                </StackPanel>
            </Border>

            <!-- Network / online access -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Network / online access" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="AniVault never accesses the internet on its own. These switches only allow features that still require an explicit action from you (the 'Search online' and 'Refresh metadata' buttons)."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <CheckBox Content="Allow online metadata search" IsChecked="{Binding OnlineSearchEnabled}" />
                    <CheckBox Content="Allow poster / backdrop downloading" IsChecked="{Binding PosterDownloadEnabled}" />
                </StackPanel>
            </Border>

            <!-- Metadata providers -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0" DataContext="{Binding Metadata}">
                <StackPanel>
                    <TextBlock Text="Metadata provider" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="Choose which source 'Search online' and 'Refresh metadata' use. Pick whichever is reachable from your network."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <RadioButton GroupName="MetaProvider" Content="{Binding DisplayName}" FontWeight="SemiBold"
                                                     IsChecked="{Binding IsActive, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="24,4,0,0" />

                                        <StackPanel Margin="24,10,0,0" Visibility="{Binding RequiresApiKey, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="{Binding HasApiKey, Converter={StaticResource ApiKeyStatus}}" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Paste your API key here" />
                                                <Button Grid.Column="1" Content="Save" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding DataContext.SaveApiKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding DataContext.ClearApiKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="Theme" Style="{StaticResource Text.Secondary}" Margin="0,8,0,4" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                              Width="160" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Database -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,24">
                <StackPanel>
                    <TextBlock Text="Database" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{Binding TotalMediaCount, StringFormat='Media items stored: {0}'}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="Schema is kept up to date automatically with Entity Framework Core migrations. Backup and restore arrive in a later phase."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
