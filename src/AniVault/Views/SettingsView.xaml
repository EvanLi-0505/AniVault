<UserControl x:Class="AniVault.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             xmlns:loc="clr-namespace:AniVault.Utilities"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="{DynamicResource Brush.Background}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Settings.Title}" Style="{StaticResource Text.Heading}" />

            <!-- Data folder -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.DataFolder}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{loc:Loc Settings.DataFolderDesc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,10" />
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DatabaseLine}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfigLine}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{loc:Loc Settings.OpenDataFolder}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="{loc:Loc Settings.OpenLogsFolder}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding OpenLogsFolderCommand}" />
                        <Button Content="{loc:Loc Settings.ChangeDataFolder}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding ChangeDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup & data -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0" DataContext="{Binding DataManagement}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.BackupData}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,4,0,12"
                               Text="{loc:Loc Settings.BackupDesc}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Settings.BackupNow}" Style="{StaticResource Button.Primary}" Command="{Binding CreateBackupCommand}" />
                        <Button Content="{loc:Loc Settings.RestoreBackup}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding RestoreBackupCommand}" />
                        <Button Content="{loc:Loc Settings.OpenBackupFolder}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding OpenBackupFolderCommand}" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,16" />

                    <TextBlock Text="{loc:Loc Settings.ExportDesc}"
                               TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
                    <Button Content="{loc:Loc Settings.ExportMarkdown}" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Ghost}" Command="{Binding ExportMarkdownCommand}" />

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisible}}" />
                </StackPanel>
            </Border>

            <!-- Network / online access -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.Network}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{loc:Loc Settings.NetworkDesc}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <CheckBox Content="{loc:Loc Settings.AllowOnlineSearch}" IsChecked="{Binding OnlineSearchEnabled}" />
                    <CheckBox Content="{loc:Loc Settings.AllowPosterDownload}" IsChecked="{Binding PosterDownloadEnabled}" />
                </StackPanel>
            </Border>

            <!-- Metadata providers -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0" DataContext="{Binding Metadata}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.MetadataProvider}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{loc:Loc Settings.MetadataProviderDesc}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <RadioButton GroupName="MetaProvider" Content="{Binding DisplayName}" FontWeight="SemiBold"
                                                     IsChecked="{Binding IsActive, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="24,4,0,0" />

                                        <StackPanel Margin="24,10,0,0" Visibility="{Binding RequiresApiKey, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Text.Secondary}"
                                                       Text="{Binding HasApiKey, Converter={StaticResource ApiKeyStatus}}" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{loc:Loc Settings.ApiKeyPlaceholder}" />
                                                <Button Grid.Column="1" Content="{loc:Loc Settings.ApiKeySave}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding DataContext.SaveApiKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="{loc:Loc Settings.ApiKeyClear}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding DataContext.ClearApiKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.Appearance}" Style="{StaticResource Text.Subheading}" />
                    <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="{loc:Loc Settings.Theme}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Settings.Language}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Database -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,24">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.Database}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{Binding MediaStoredLine}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Loc Settings.DatabaseDesc}"
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
