<Window x:Class="AniVault.Views.OnlineSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AniVault.Utilities"
        xmlns:vm="clr-namespace:AniVault.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OnlineSearchViewModel}"
        Title="{Binding HeaderText}"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <DockPanel Margin="20">
        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisible}}" />
            <Button Content="{loc:Loc Common.Close}" HorizontalAlignment="Right" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCommand}" />
        </Grid>

        <!-- Search bar -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                      DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedProvider.Description}" />
            <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Loc Online.QueryTooltip}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="{loc:Loc Common.Search}" Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding SearchCommand}" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" Margin="0,8,0,0"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />

        <!-- Results + preview -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="46" Height="64" CornerRadius="4" ClipToBounds="True"
                                        Background="{DynamicResource Brush.SurfaceAlt}">
                                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding YearLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{loc:Loc Online.SelectToPreview}" Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}" />

                <ProgressBar Style="{StaticResource BusyBar}" VerticalAlignment="Top"
                             Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="120" Height="170" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource Brush.SurfaceAlt}">
                                <Image Source="{Binding PreviewPosterUrl}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Text.Subheading}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PreviewOriginalTitle}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                           Visibility="{Binding PreviewOriginalTitle, Converter={StaticResource NotEmptyToVisible}}" />
                                <TextBlock Text="{Binding PreviewFacts}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PreviewGenresLine}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding PreviewGenres, Converter={StaticResource NotEmptyToVisible}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding PreviewDescription}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="{Binding PreviewDescription, Converter={StaticResource NotEmptyToVisible}}" />

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox Content="{loc:Loc Online.ImportGenres}" IsChecked="{Binding ImportGenresAsTags}" />
                                <CheckBox Content="{loc:Loc Online.DownloadPoster}" IsChecked="{Binding DownloadPoster}"
                                          IsEnabled="{Binding PosterDownloadAllowed}" Margin="0,4,0,0" />
                                <CheckBox Content="{loc:Loc Online.DownloadBackdrop}" IsChecked="{Binding DownloadBackdrop}"
                                          IsEnabled="{Binding PosterDownloadAllowed}" Margin="0,4,0,0" />
                                <TextBlock Text="{loc:Loc Online.PosterDownloadOff}"
                                           Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding PosterDownloadAllowed, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Loc Online.AddToLibrary}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Style="{StaticResource Button.Primary}" Command="{Binding AddToLibraryCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
