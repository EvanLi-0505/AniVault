<Window x:Class="AniVault.Views.RatingCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AniVault.Utilities"
        xmlns:vm="clr-namespace:AniVault.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RatingCalculatorViewModel}"
        Title="{loc:Loc Rating.QuestionnaireTitle}"
        Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <Style x:Key="Facet" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="FacetLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FacetRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="22">

        <!-- Result + actions -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BreakdownText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FinalText}" Style="{StaticResource Text.Heading}" FontSize="20" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Common.Cancel}" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCommand}" />
                    <Button Content="{loc:Loc Rating.Assign}" Margin="10,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding AssignCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{loc:Loc Rating.QuestionnaireIntro}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />

                <Grid Style="{StaticResource FacetRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Rating.Plot}" Style="{StaticResource FacetLabel}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource Facet}" ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Plot}" />
                </Grid>
                <Grid Style="{StaticResource FacetRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Rating.Production}" Style="{StaticResource FacetLabel}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource Facet}" ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Production}" />
                </Grid>
                <Grid Style="{StaticResource FacetRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Rating.Characters}" Style="{StaticResource FacetLabel}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource Facet}" ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Characters}" />
                </Grid>
                <Grid Style="{StaticResource FacetRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Rating.Music}" Style="{StaticResource FacetLabel}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource Facet}" ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Music}" />
                </Grid>
                <Grid Style="{StaticResource FacetRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Rating.Immersion}" Style="{StaticResource FacetLabel}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource Facet}" ItemsSource="{Binding ScoreOptions}" SelectedItem="{Binding Immersion}" />
                </Grid>

                <CheckBox Content="{loc:Loc Rating.BonusRewatch}" IsChecked="{Binding WillRewatch}" Margin="0,16,0,0" />
                <CheckBox Content="{loc:Loc Rating.BonusSequel}" IsChecked="{Binding WantsSequel}" Margin="0,6,0,0" />

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Rating.GuideHeader}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Rating.GuideSummary}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="{loc:Loc Rating.GuideOpen}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Style="{StaticResource Button.Ghost}" Command="{Binding OpenGuideCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
