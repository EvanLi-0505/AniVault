<UserControl x:Class="AniVault.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AniVault.Controls"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             xmlns:loc="clr-namespace:AniVault.Utilities"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LibraryViewModel}"
             Background="{DynamicResource Brush.Background}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{Binding HeaderCountText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:Loc Library.BrowseSeasons}" Margin="0,0,8,0" Style="{StaticResource Button.Ghost}"
                        Command="{Binding BrowseSeasonsCommand}"
                        Visibility="{Binding ShowSeasonBrowser, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{loc:Loc Library.SearchOnline}" Margin="0,0,8,0" Style="{StaticResource Button.Ghost}"
                        Command="{Binding SearchOnlineCommand}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding AddButtonText}"
                        Style="{StaticResource Button.Primary}" Command="{Binding AddMediaCommand}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- Rating guide (My Rating page only): short intro + a button to the full window -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0"
                Visibility="{Binding RatingGuideVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Rating.GuideHeader}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Rating.GuideSummary}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc Rating.GuideOpen}" VerticalAlignment="Center" Margin="16,0,0,0"
                        Style="{StaticResource Button.Ghost}" Command="{Binding OpenRatingGuideCommand}" />
            </Grid>
        </Border>

        <!-- Filters -->
        <controls:FilterPanel Grid.Row="2" Margin="0,16,0,16" DataContext="{Binding Filters}" />

        <!-- Content -->
        <Grid Grid.Row="3" SizeChanged="OnCardAreaSizeChanged">
            <controls:EmptyState Title="{loc:Loc Library.EmptyTitle}"
                                 Message="{Binding EmptyStateText}"
                                 ActionText="{Binding AddButtonText}"
                                 ActionCommand="{Binding AddMediaCommand}"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <!-- MaxWidth is set in code-behind to a whole number of card columns; the view model
                     is told the same number, so its page size is always a whole number of rows. -->
                <ItemsControl x:Name="CardGrid" ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Centred: the panel is only as wide as its widest row, so the space the
                                 fixed-width cards cannot fill is split evenly left and right. -->
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard Margin="7,0,7,14"
                                                OpenCommand="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                EditCommand="{Binding DataContext.EditMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                DeleteCommand="{Binding DataContext.DeleteMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Pager -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding PagingVisible, Converter={StaticResource BoolToVisibility}}">
            <Button Content="‹" Style="{StaticResource Button.Ghost}" Padding="14,4" MinWidth="0" Command="{Binding PrevPageCommand}" />
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="14,0" />
            <Button Content="›" Style="{StaticResource Button.Ghost}" Padding="14,4" MinWidth="0" Command="{Binding NextPageCommand}" />
            <TextBox Width="48" Margin="14,0,0,0" VerticalContentAlignment="Center" TextAlignment="Center"
                     Text="{Binding PageJumpText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Loc Common.JumpToPageTooltip}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding GoToPageCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="{loc:Loc Common.Go}" Margin="6,0,0,0" Padding="10,4" Style="{StaticResource Button.Ghost}" Command="{Binding GoToPageCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
