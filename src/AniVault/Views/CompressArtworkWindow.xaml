<Window x:Class="AniVault.Views.CompressArtworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AniVault.Utilities"
        xmlns:controls="clr-namespace:AniVault.Controls"
        xmlns:vm="clr-namespace:AniVault.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:CompressArtworkViewModel}"
        Title="{loc:Loc CompressArtwork.Title}"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc CompressArtwork.Title}" Style="{StaticResource Text.Heading}" FontSize="18" />
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc CompressArtwork.Description}" Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap" Margin="0,6,0,14" />

        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource BusyBar}" Margin="0,0,0,10"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc CompressArtwork.SelectAll}" Style="{StaticResource Button.Ghost}" Command="{Binding SelectAllCommand}" />
                <Button Content="{loc:Loc CompressArtwork.SelectNone}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common.Cancel}" Style="{StaticResource Button.Ghost}" Command="{Binding CloseCommand}" />
                <Button Content="{Binding CompressButtonLabel}" Margin="10,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding CompressCommand}" />
            </StackPanel>
        </Grid>

        <controls:EmptyState Title="{loc:Loc CompressArtwork.EmptyTitle}"
                             Message="{loc:Loc CompressArtwork.EmptyMessage}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,10,0"
                                          IsChecked="{Binding IsSelected}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeLabel, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
