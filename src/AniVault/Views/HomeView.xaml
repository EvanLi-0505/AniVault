<UserControl x:Class="AniVault.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AniVault.Utilities"
             xmlns:controls="clr-namespace:AniVault.Controls"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             Background="{DynamicResource Brush.Background}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel>
            <TextBlock Text="{loc:Loc Home.Title}" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="{loc:Loc Home.Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />

            <!-- Library totals -->
            <ItemsControl Margin="0,22,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding AnimeCount}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{loc:Loc Home.CountAnime}" Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding MovieCount}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{loc:Loc Home.CountMovies}" Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18,14" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding TvCount}" Style="{StaticResource Text.Heading}" />
                        <TextBlock Text="{loc:Loc Home.CountTv}" Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <!-- Empty state -->
            <controls:EmptyState Title="{loc:Loc Home.EmptyTitle}" Margin="0,24,0,0" HorizontalAlignment="Left"
                                 Message="{loc:Loc Home.EmptyMessage}"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Margin="0,26,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <controls:MediaRow Header="{loc:Loc Home.ContinueWatching}" ItemsSource="{Binding ContinueWatching}"
                                   OpenCommand="{Binding OpenMediaCommand}" Margin="0,0,0,20"
                                   Visibility="{Binding HasContinueWatching, Converter={StaticResource BoolToVisibility}}" />

                <controls:MediaRow Header="{loc:Loc Home.HighestRated}" ItemsSource="{Binding HighestRated}"
                                   OpenCommand="{Binding OpenMediaCommand}" Margin="0,0,0,20"
                                   Visibility="{Binding HasHighestRated, Converter={StaticResource BoolToVisibility}}" />

                <controls:MediaRow Header="{loc:Loc Home.RecentlyAdded}" ItemsSource="{Binding RecentlyAdded}"
                                   OpenCommand="{Binding OpenMediaCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
