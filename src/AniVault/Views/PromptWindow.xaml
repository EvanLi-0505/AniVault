<Window x:Class="AniVault.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AniVault"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Ghost}" IsCancel="True" />
            <Button Content="OK" Margin="10,0,0,0" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
