<UserControl x:Class="AniVault.Views.MediaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AniVault.Utilities"
             xmlns:controls="clr-namespace:AniVault.Controls"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MediaDetailViewModel}"
             Background="{DynamicResource Brush.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding GoBackCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left">

            <!-- Backdrop banner (only when the item has one) -->
            <Border CornerRadius="{StaticResource Radius.Card}" Height="200" Margin="0,0,0,16" ClipToBounds="True"
                    Visibility="{Binding HasBackdrop, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Image Source="{Binding Backdrop}" Stretch="UniformToFill" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource Color.ScrimSoft}" Offset="0" />
                                <GradientStop Color="{DynamicResource Color.Scrim}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- Header row -->
            <Grid>
                <Button Content="{loc:Loc Common.Back}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Detail.RefreshMetadata}" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshMetadataCommand}"
                            Visibility="{Binding CanRefreshMetadata, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{loc:Loc Common.Edit}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding EditCommand}" />
                    <Button Content="{loc:Loc Common.Delete}" Margin="8,0,0,0" Style="{StaticResource Button.DangerGhost}" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </Grid>

            <!-- Poster + primary info -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Width="240" Height="340" ClipToBounds="True">
                    <Grid>
                        <Border Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock Text="{loc:Loc Card.NoPoster}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Muted}" />
                        </Border>
                        <Image Source="{Binding Poster}" Stretch="UniformToFill"
                               Visibility="{Binding Poster, Converter={StaticResource NotEmptyToVisible}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="22,0,0,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OriginalTitle}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"
                               Visibility="{Binding OriginalTitle, Converter={StaticResource NotEmptyToVisible}}" />

                    <!-- Badges -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <controls:StatusBadge Status="{Binding Status}" VerticalAlignment="Center" />
                        <controls:RatingStars Value="{Binding MyRating}" Margin="14,0,0,0" />
                    </StackPanel>

                    <!-- Quick personal-data controls -->
                    <WrapPanel Margin="0,16,0,0">
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="{loc:Loc Detail.Status}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" Width="200">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="{loc:Loc Detail.MyRating}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="90" Text="{Binding MyRating, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                <Button Content="{loc:Loc Rating.QuestionnaireButton}" Margin="8,0,0,0" Padding="10,0"
                                        Style="{StaticResource Button.Ghost}" Command="{Binding OpenRatingCalculatorCommand}"
                                        ToolTip="{loc:Loc Rating.QuestionnaireTooltip}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <ToggleButton IsChecked="{Binding IsFavorite, Mode=OneWay}" Margin="0,0,8,0" Padding="12,7"
                                          Command="{Binding ToggleFavoriteCommand}" Content="{loc:Loc Detail.Favorite}" />
                            <ToggleButton IsChecked="{Binding IsLiked, Mode=OneWay}" Margin="0,0,8,0" Padding="12,7"
                                          Command="{Binding ToggleLikedCommand}" Content="{loc:Loc Detail.Liked}" />
                            <ToggleButton IsChecked="{Binding ShowOnHome, Mode=OneWay}" Padding="12,7"
                                          Command="{Binding ToggleShowOnHomeCommand}" Content="{loc:Loc Detail.ShowOnHome}"
                                          ToolTip="{loc:Loc Detail.ShowOnHomeTooltip}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Info rows -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Text.Secondary}" Margin="0,2" />
                        <TextBlock Text="{Binding BroadcastLabel}" Style="{StaticResource Text.Secondary}" Margin="0,2"
                                   Visibility="{Binding BroadcastLabel, Converter={StaticResource NotEmptyToVisible}}" />
                        <TextBlock Text="{Binding DateRangeLabel}" Style="{StaticResource Text.Secondary}" Margin="0,2"
                                   Visibility="{Binding DateRangeLabel, Converter={StaticResource NotEmptyToVisible}}" />
                        <TextBlock Text="{Binding RuntimeLabel}" Style="{StaticResource Text.Secondary}" Margin="0,2"
                                   Visibility="{Binding RuntimeLabel, Converter={StaticResource NotEmptyToVisible}}" />
                        <TextBlock Text="{Binding CountryLabel}" Style="{StaticResource Text.Secondary}" Margin="0,2"
                                   Visibility="{Binding CountryLabel, Converter={StaticResource NotEmptyToVisible}}" />
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Detail.Tags}" Style="{StaticResource Text.Muted}" />
                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Padding="9,3" FontSize="12" Margin="0,0,6,6"
                                                Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.OpenTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Content="{loc:Loc Detail.OpenWebsite}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Style="{StaticResource Button.Ghost}" Command="{Binding OpenWebsiteCommand}"
                                Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Description -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0"
                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Detail.Description}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Episodes -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Loc Detail.Episodes}" Style="{StaticResource Text.Subheading}" />
                        <TextBlock Text="{Binding EpisodeProgressLabel}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                    </Grid>

                    <Button Content="{loc:Loc Detail.CreateEpisodeList}" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Ghost}" Command="{Binding GenerateEpisodesCommand}"
                            Visibility="{Binding CanGenerateEpisodes, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{loc:Loc Detail.NoEpisodesHint}"
                               Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                               Visibility="{Binding HasEpisodes, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Episodes}" Margin="0,10,0,0"
                                  Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Margin="0,0,8,8" Padding="10,6">
                                    <CheckBox IsChecked="{Binding IsWatched}" Content="{Binding Label}"
                                              ToolTip="{Binding Title}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                            Visibility="{Binding ShowCompleteSuggestion, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Detail.AllWatched}" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" />
                            <Button Content="{loc:Loc Detail.MarkCompleted}" Margin="12,0,0,0" Style="{StaticResource Button.Primary}"
                                    Command="{Binding MarkCompletedCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Notes -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,24"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Detail.MyNotes}" Style="{StaticResource Text.Subheading}" />
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
