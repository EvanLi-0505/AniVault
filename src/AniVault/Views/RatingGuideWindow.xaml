<Window x:Class="AniVault.Views.RatingGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AniVault.Utilities"
        Title="{loc:Loc Rating.GuideHeader}"
        Height="760" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FlowDocumentScrollViewer x:Name="GuideViewer" Grid.Row="0" IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  Background="{DynamicResource Brush.Surface}"
                                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="18" />

        <Button Grid.Row="1" Content="{loc:Loc Common.Close}" HorizontalAlignment="Right" Margin="0,14,0,0"
                Style="{StaticResource Button.Primary}" IsCancel="True" />
    </Grid>
</Window>
