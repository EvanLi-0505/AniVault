<Window x:Class="AniVault.Views.MediaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AniVault.Utilities"
        xmlns:vm="clr-namespace:AniVault.ViewModels"
        xmlns:controls="clr-namespace:AniVault.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MediaEditorViewModel}"
        Title="{Binding WindowTitle}"
        Height="720" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:Loc Common.Cancel}" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCommand}" />
            <Button Content="{loc:Loc Common.Save}" Margin="10,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding WindowTitle}" Style="{StaticResource Text.Heading}" FontSize="18" Margin="0,0,0,4" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="{loc:Loc Editor.TitleField}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                <TextBlock Text="{loc:Loc Editor.OriginalTitle}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding OriginalTitle}" />

                <TextBlock Text="{loc:Loc Editor.AltTitles}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding AlternativeTitles}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />

                <TextBlock Text="{loc:Loc Editor.Description}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Editor.Year}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AirYear, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Editor.Month}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AirMonth, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Visibility="{Binding ShowAnimeFields, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Editor.Season}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding AnimeSeasonOptions}" SelectedItem="{Binding AirSeason}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="{loc:Loc Editor.Episodes}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EpisodeCount, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding ShowRuntimeField, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Left" Width="180">
                        <TextBlock Text="{loc:Loc Editor.RuntimeMinutes}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RuntimeMinutes, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Editor.StartDate}" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding StartDate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Editor.EndDate}" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding EndDate}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Editor.Country}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Country}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Editor.Website}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding OfficialWebsite}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Editor.Status}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding WatchStatusOptions}" SelectedItem="{Binding Status}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Editor.MyRating}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding MyRating, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox Content="{loc:Loc Editor.Favorite}" IsChecked="{Binding IsFavorite}" Margin="0,0,20,0" />
                    <CheckBox Content="{loc:Loc Editor.Liked}" IsChecked="{Binding IsLiked}" />
                </StackPanel>

                <TextBlock Text="{loc:Loc Editor.Tags}" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding Tags.SelectedTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:TagChip Text="{Binding}"
                                              RemoveCommand="{Binding DataContext.Tags.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" IsEditable="True" StaysOpenOnEdit="True"
                              Text="{Binding Tags.NewTagText, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Tags.Suggestions}">
                        <ComboBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding Tags.AddTagCommand}" />
                        </ComboBox.InputBindings>
                    </ComboBox>
                    <Button Grid.Column="1" Content="{loc:Loc Editor.AddTag}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                            Command="{Binding Tags.AddTagCommand}" />
                </Grid>

                <TextBlock Text="{loc:Loc Editor.Notes}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Editor.Poster}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Card}" Height="180" Width="128" HorizontalAlignment="Left" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{loc:Loc Editor.NoPoster}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                                <Image Source="{Binding PosterDisplayPath}" Stretch="UniformToFill"
                                       Visibility="{Binding PosterDisplayPath, Converter={StaticResource NotEmptyToVisible}}" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{loc:Loc Common.Choose}" Style="{StaticResource Button.Ghost}" Command="{Binding BrowsePosterCommand}" />
                            <Button Content="{loc:Loc Common.Clear}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding ClearPosterCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Editor.Backdrop}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Card}" Height="120" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{loc:Loc Editor.NoBackdrop}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" />
                                <Image Source="{Binding BackdropDisplayPath}" Stretch="UniformToFill"
                                       Visibility="{Binding BackdropDisplayPath, Converter={StaticResource NotEmptyToVisible}}" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{loc:Loc Common.Choose}" Style="{StaticResource Button.Ghost}" Command="{Binding BrowseBackdropCommand}" />
                            <Button Content="{loc:Loc Common.Clear}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding ClearBackdropCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{loc:Loc Editor.ImagesNote}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
