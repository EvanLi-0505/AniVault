<UserControl x:Class="AniVault.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AniVault.Utilities"
             xmlns:controls="clr-namespace:AniVault.Controls"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TagsViewModel}"
             Background="{DynamicResource Brush.Background}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Tags.Title}" Style="{StaticResource Text.Heading}" />

        <Grid Grid.Row="1" Margin="0,16,0,12" MaxWidth="560">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- New-tag input: icon + text, with a watermark shown while empty. The TextBox
                 is borderless/transparent so it blends into the surrounding themed Border. -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Height="40"
                    MouseDown="OnNewTagBoxMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🏷" FontSize="15" Opacity="0.75"
                               Margin="12,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="NewTagBox" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" FontSize="14"
                                 Padding="0,0,10,0" VerticalContentAlignment="Center"
                                 ToolTip="{loc:Loc Tags.NewPlaceholder}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CreateTagCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{loc:Loc Tags.NewPlaceholder}" Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding NewTagName, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="{loc:Loc Tags.CreateTag}" Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding CreateTagCommand}" />
            <Button Grid.Column="2" Content="{loc:Loc Tags.RemoveUnused}" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding DeleteUnusedCommand}" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{loc:Loc Tags.DragHint}" Style="{StaticResource Text.Muted}"
                   Margin="0,0,0,8" TextWrapping="Wrap"
                   Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" />

        <controls:EmptyState Grid.Row="3" Title="{loc:Loc Tags.EmptyTitle}"
                             Message="{loc:Loc Tags.EmptyMessage}"
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding VisibleTags}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="OnTagRowPreviewMouseDown"
                                PreviewMouseMove="OnTagRowPreviewMouseMove"
                                DragEnter="OnTagRowDragEnter"
                                DragLeave="OnTagRowDragLeave"
                                Drop="OnTagRowDrop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⠿" FontSize="15" Opacity="0.5"
                                           Margin="0,0,10,0" VerticalAlignment="Center"
                                           Cursor="SizeAll" ToolTip="{loc:Loc Tags.DragHandleTooltip}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UsageLabel}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="{loc:Loc Common.Open}" Padding="10,3" FontSize="12" Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DataContext.OpenTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{loc:Loc Common.Rename}" Padding="10,3" FontSize="12" Margin="6,0,0,0" Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{loc:Loc Common.Delete}" Padding="10,3" FontSize="12" Margin="6,0,0,0" Style="{StaticResource Button.DangerGhost}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pager: the Prev/Next buttons double as drop zones — hover a dragged tag over one
             for a moment (without dropping) to page there and keep dragging. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding PagingVisible, Converter={StaticResource BoolToVisibility}}">
            <Button x:Name="PrevPageButton" Content="‹" Padding="14,4" MinWidth="0" Style="{StaticResource Button.Ghost}"
                    Command="{Binding PrevPageCommand}" ToolTip="{loc:Loc Tags.DragToPagePrevTooltip}"
                    AllowDrop="True" DragEnter="OnPagerDragEnter" DragLeave="OnPagerDragLeave" Drop="OnPagerDrop" />
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="14,0" />
            <Button x:Name="NextPageButton" Content="›" Padding="14,4" MinWidth="0" Style="{StaticResource Button.Ghost}"
                    Command="{Binding NextPageCommand}" ToolTip="{loc:Loc Tags.DragToPageNextTooltip}"
                    AllowDrop="True" DragEnter="OnPagerDragEnter" DragLeave="OnPagerDragLeave" Drop="OnPagerDrop" />
            <TextBox Width="48" Margin="14,0,0,0" VerticalContentAlignment="Center" TextAlignment="Center"
                     Text="{Binding PageJumpText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Loc Common.JumpToPageTooltip}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding GoToPageCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="{loc:Loc Common.Go}" Margin="6,0,0,0" Padding="10,4" Style="{StaticResource Button.Ghost}" Command="{Binding GoToPageCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
