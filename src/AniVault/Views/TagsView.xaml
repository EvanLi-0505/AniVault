<UserControl x:Class="AniVault.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AniVault.Controls"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TagsViewModel}"
             Background="{DynamicResource Brush.Background}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tags" Style="{StaticResource Text.Heading}" />

        <Grid Grid.Row="1" Margin="0,16,0,12" MaxWidth="560" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Create a new tag">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding CreateTagCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Create tag" Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding CreateTagCommand}" />
            <Button Grid.Column="2" Content="Remove unused" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}" Command="{Binding DeleteUnusedCommand}" />
        </Grid>

        <controls:EmptyState Grid.Row="2" Title="No tags yet"
                             Message="Create tags here, or add them while editing a media item."
                             Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UsageLabel}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Open" Padding="10,3" FontSize="12" Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DataContext.OpenTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Rename" Padding="10,3" FontSize="12" Margin="6,0,0,0" Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete" Padding="10,3" FontSize="12" Margin="6,0,0,0" Style="{StaticResource Button.DangerGhost}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
