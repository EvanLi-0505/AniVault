<Window x:Class="AniVault.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:AniVault.Utilities"
        xmlns:vm="clr-namespace:AniVault.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FirstRunViewModel}"
        Title="{loc:Loc FirstRun.Title}"
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc FirstRun.Welcome}" Style="{StaticResource Text.Heading}" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,0"
                   Style="{StaticResource Text.Secondary}"
                   Text="{loc:Loc FirstRun.Intro}" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc FirstRun.DataFolder}" Style="{StaticResource Text.Subheading}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="{loc:Loc FirstRun.Browse}" Margin="10,0,0,0"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding BrowseCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="2,14,0,0"
                   Style="{StaticResource Text.Muted}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisible}}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc FirstRun.CreateLibrary}"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding ContinueCommand}" />
        </StackPanel>
    </Grid>
</Window>
