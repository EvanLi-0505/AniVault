<UserControl x:Class="AniVault.Views.SeasonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AniVault.Controls"
             xmlns:vm="clr-namespace:AniVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SeasonsViewModel}"
             Background="{DynamicResource Brush.Background}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Seasons" Style="{StaticResource Text.Heading}" />
            <TextBlock Text="Anime by original broadcast year and season — not when you watched it."
                       Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <controls:EmptyState Grid.Row="1" Title="No dated anime yet"
                             Message="Add anime with a broadcast year and season, and they will show up here."
                             Visibility="{Binding HasNoAnime, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="1" Margin="0,18,0,0"
              Visibility="{Binding HasNoAnime, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Year list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Width="118" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <ItemsControl ItemsSource="{Binding Years}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,1" Padding="10,7" Cursor="Hand" HorizontalContentAlignment="Left"
                                        Command="{Binding DataContext.SelectYearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Year}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource Text.Muted}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Season tabs + grid -->
            <DockPanel Grid.Column="1" Margin="16,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <ItemsControl ItemsSource="{Binding Seasons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,8,0" Padding="16,7"
                                              Command="{Binding DataContext.SelectSeasonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Count}" Margin="8,0,0,0" Opacity="0.7" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding CurrentSelectionLabel}" Style="{StaticResource Text.Subheading}" Margin="2,16,0,10" />
                </StackPanel>

                <controls:EmptyState Title="Nothing this season"
                                     Message="No anime in your library was broadcast in this season."
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MediaCard Margin="0,0,14,14"
                                                    OpenCommand="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
