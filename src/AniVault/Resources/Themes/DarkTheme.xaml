<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        AniVault DARK palette. LightTheme.xaml provides the same keys with light values;
        ThemeService swaps the whole dictionary at runtime. Every View/Control references
        these with DynamicResource so the swap takes effect immediately.
    -->

    <Color x:Key="Color.Background">#12141A</Color>
    <Color x:Key="Color.Surface">#1B1E26</Color>
    <Color x:Key="Color.SurfaceAlt">#232733</Color>
    <Color x:Key="Color.SurfaceHover">#2B303D</Color>
    <Color x:Key="Color.Border">#333846</Color>
    <Color x:Key="Color.Primary">#6C8CFF</Color>
    <Color x:Key="Color.PrimaryHover">#8AA2FF</Color>
    <Color x:Key="Color.PrimaryPressed">#566FD6</Color>
    <Color x:Key="Color.OnAccent">#0E1016</Color>
    <Color x:Key="Color.TextPrimary">#EDEFF5</Color>
    <Color x:Key="Color.TextSecondary">#A2A8B8</Color>
    <Color x:Key="Color.TextMuted">#6E7485</Color>
    <Color x:Key="Color.Danger">#E5484D</Color>
    <Color x:Key="Color.Favorite">#FF6B81</Color>
    <Color x:Key="Color.Star">#F5C518</Color>
    <Color x:Key="Color.Scrim">#CC12141A</Color>
    <Color x:Key="Color.ScrimSoft">#0012141A</Color>

    <Color x:Key="Color.StatusPlanned">#8A93A6</Color>
    <Color x:Key="Color.StatusWatching">#6C8CFF</Color>
    <Color x:Key="Color.StatusCompleted">#3FB950</Color>
    <Color x:Key="Color.StatusOnHold">#D29922</Color>
    <Color x:Key="Color.StatusDropped">#E5484D</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Favorite" Color="{StaticResource Color.Favorite}" />
    <SolidColorBrush x:Key="Brush.Star" Color="{StaticResource Color.Star}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />

    <SolidColorBrush x:Key="Brush.StatusPlanned" Color="{StaticResource Color.StatusPlanned}" />
    <SolidColorBrush x:Key="Brush.StatusWatching" Color="{StaticResource Color.StatusWatching}" />
    <SolidColorBrush x:Key="Brush.StatusCompleted" Color="{StaticResource Color.StatusCompleted}" />
    <SolidColorBrush x:Key="Brush.StatusOnHold" Color="{StaticResource Color.StatusOnHold}" />
    <SolidColorBrush x:Key="Brush.StatusDropped" Color="{StaticResource Color.StatusDropped}" />

    <!-- Shared metrics (kept in every theme dictionary so a swap never loses them) -->
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>

</ResourceDictionary>
