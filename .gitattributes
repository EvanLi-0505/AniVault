# Normalise line endings so the repo is consistent regardless of contributor OS.
* text=auto eol=lf

# Windows-oriented scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat these as binary.
*.ico binary
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.db binary
